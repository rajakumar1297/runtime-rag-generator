# Environment Variables - Copy this to .env and fill in your values

# ===== LLM Configuration =====
# Using Google Gemini (free tier via Google AI Studio)
# Get your free API key at: https://aistudio.google.com/apikey
LLM_PROVIDER=google
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-2.0-flash

# Alternative: OpenAI (requires paid API key)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# ===== Embedding Configuration =====
# "local" uses sentence-transformers (free, no API key needed)
# "openai" uses OpenAI embeddings (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ===== ChromaDB Configuration =====
CHROMA_PERSIST_DIR=./chroma_db

# ===== Chunking Configuration =====
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ===== Server Configuration =====
HOST=0.0.0.0
PORT=8000
